# URL du flux .ics public de Google Calendar
# Format: https://calendar.google.com/calendar/ical/VOTRE_CALENDRIER_ID/public/basic.ics
# Étapes:
#   1. Ouvrir Google Calendar
#   2. Paramètres du calendrier → Intégrer le calendrier
#   3. Copier l'URL sous "Adresse au format iCal"
GCAL_ICS_URL=

# Vercel KV — injectées automatiquement par Vercel quand KV est activé sur le projet
# En développement local, ces variables peuvent être omises (cache désactivé, fetch direct)
KV_REST_API_URL=
KV_REST_API_TOKEN=
